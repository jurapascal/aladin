{
  "name": "claude-code-hub-desktop",
  "productName": "Claude Code Hub",
  "version": "1.1.1",
  "description": "Okno pro Claude Code Hub: vlastní aplikace s vlastním menu a novými okny místo karty v Chromu.",
  "main": "main.js",
  "license": "MIT",
  "repository": "https://github.com/jurapascal/claude-code-hub",
  "author": "Claude Code Hub",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.mjs",
    "ikony": "node tools/ikony.mjs",
    "dist": "npm run ikony && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.github.jurapascal.claude-code-hub.desktop",
    "productName": "Claude Code Hub",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "artifactName": "Claude-Code-Hub-Desktop-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Claude Code Hub používá mikrofon pro diktování zpráv."
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "claude-code-hub"
    },
    "afterPack": "tools/adhoc-podpis.cjs"
  },
  "desktopName": "claude-code-hub.desktop"
}
